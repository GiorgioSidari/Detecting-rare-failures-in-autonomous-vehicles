# PyCharm project metadata
.idea/

# Ambienti virtuali
.venv/
venv/

# File di cache di Python
__pycache__/
*.py[cod]

# File di Build creati da setuptools
build/
*.egg-info/

# Generated images from scripts
*.png
*.jpg
*.jpeg

# Trained model weights (large binary files — run train.py to regenerate)
*.keras
*.h5
*.pt
*.pth

# Generated datasets (large numpy arrays — regenerated by train.py --dataset-only)
*.npy
scenarios/*/dataset/
scenarios/*/models/

# Generated analysis outputs (regenerated by the scripts)
envelope.csv
envelope*.csv

# Campaign outputs from run_model_comparison.py / run_qoi_optimizer.py.
# These are simulation results, not source: hours of Unity per file, and they
# change on every run. Keep the numbers you want to cite in RESULTS.md instead.
# NOTE: *_raw.npz holds the evaluated points and is the only file you cannot
# regenerate without re-running the simulator — back it up outside git if a
# campaign matters (the *.npy rule above already covers plain numpy dumps).
results/
*_raw.npz
*_regions.csv
*_arms.csv

# API job store (runtime only)
*.jobstore

# OS
.DS_Store
Thumbs.db
